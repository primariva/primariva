---
import { lavori } from '../content/lavori';

const ciSonoDimostrativi = lavori.some((l) => l.dimostrativo);

const etichettaTipo: Record<string, string> = {
  bagno: 'Bagno',
  ristorante: 'Ristorante',
  bar: 'Bar',
  terme: 'Terme',
  discoteca: 'Discoteca',
  agriturismo: 'Agriturismo',
  hotel: 'Hotel',
  altro: 'Locale',
};
---

<section id="lavori" class="py-16 md:py-24 bg-white/60 border-y-2 border-navy/10 relative overflow-hidden">
  <!-- Parola di fondale, puro segno grafico. -->
  <span class="parola-fondale absolute -top-3 left-1/2 -translate-x-1/2 text-[clamp(5rem,16vw,13rem)]" aria-hidden="true">
    LAVORI
  </span>

  <div class="contenitore relative">
    <div class="rivela max-w-[62ch]">
      <p class="occhiello">{ciSonoDimostrativi ? 'Progetti dimostrativi' : 'I nostri lavori'}</p>
      <h2 class="mt-4 titolone">
        {ciSonoDimostrativi ? (
          <>Modelli che abbiamo <span class="marcato">costruito noi</span>.</>
        ) : (
          <>Cosa abbiamo fatto.</>
        )}
      </h2>

      {ciSonoDimostrativi && (
        <!--
          ⚠️ Questa riga non va tolta finché ci sono progetti dimostrativi.
          È ciò che vi distingue da chi gonfia il portfolio.
        -->
        <p class="mt-5 text-fumo text-lg">
          Primariva è nata da poco e i primi clienti sono in corso. Quelli che
          vedi qui sotto non sono lavori per clienti: sono modelli che abbiamo
          realizzato noi per mostrare come lavoriamo. Quando i primi risultati
          veri arriveranno, li troverai qui con i numeri e la fonte.
        </p>
      )}
    </div>
  </div>

  <!-- Carosello a snap sul mobile, griglia sfalsata sul desktop. -->
  <div class="mt-10 contenitore relative">
    <ul
      class="scorri-snap flex gap-5 overflow-x-auto pb-3 -mx-5 px-5 md:mx-0 md:px-0 md:grid md:grid-cols-2 lg:grid-cols-3 md:overflow-visible md:gap-6"
    >
      {lavori.map((l, i) => (
        <li
          class={`shrink-0 w-[84vw] max-w-[350px] md:w-auto md:max-w-none rivela ${i % 2 === 1 ? 'lg:translate-y-8' : ''}`}
        >
          <article class="scheda overflow-hidden flex flex-col h-full transition-all duration-300 hover:shadow-[var(--shadow-scheda-alta)] hover:-translate-y-1.5">
            <!-- Cornice da browser: dice "questo è un sito" senza dirlo. -->
            <div class="bg-navy px-4 py-2.5 flex items-center gap-2">
              <span class="flex gap-1.5" aria-hidden="true">
                <span class="w-2.5 h-2.5 rounded-full bg-panna/30"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-panna/30"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-sabbia"></span>
              </span>
              <span class="ml-2 text-panna/60 text-[0.6875rem] font-medium tracking-wide truncate">
                {etichettaTipo[l.tipoAttivita] ?? 'Locale'} · {l.comune}
              </span>
            </div>

            {l.immagini.length > 0 && l.immagini[0] ? (
              <img
                src={l.immagini[0].src}
                alt={l.immagini[0].alt}
                width="680"
                height="440"
                loading="lazy"
                decoding="async"
                class="w-full aspect-[17/11] object-cover"
              />
            ) : (
              /* Segnaposto: meglio di un'immagine rotta, e ricorda di sostituirlo. */
              <div
                class="w-full aspect-[17/10] bg-gradient-to-br from-sabbia to-[#efe6d3] flex items-center justify-center relative overflow-hidden"
                aria-hidden="true"
              >
                <span class="parola-fondale absolute bottom-2 left-3 text-[3.2rem] [-webkit-text-stroke:1.2px_rgb(16_42_76/0.2)]">
                  {(etichettaTipo[l.tipoAttivita] ?? 'Locale').toUpperCase()}
                </span>
                <svg class="w-24 h-24 opacity-40" viewBox="0 0 44 44" fill="none">
                  <path d="M4 29c4.5 0 4.5-6 9-6s4.5 6 9 6 4.5-6 9-6 4.5 6 9 6" stroke="#102A4C" stroke-width="3" stroke-linecap="round" />
                  <path d="M8 15h28" stroke="#102A4C" stroke-width="3" stroke-linecap="round" opacity="0.5" />
                </svg>
              </div>
            )}

            <div class="p-5 md:p-6 flex flex-col grow">
              {l.dimostrativo && (
                <span class="self-start text-[0.625rem] font-bold uppercase tracking-[0.14em] bg-navy text-panna px-2.5 py-1 rounded-full">
                  Modello dimostrativo
                </span>
              )}
              <h3 class="mt-3 text-[1.25rem] leading-tight">{l.titolo}</h3>

              <ul class="mt-3.5 space-y-2 text-[0.9375rem] text-fumo grow">
                {l.cosaAbbiamoFatto.map((c) => (
                  <li class="flex gap-2.5">
                    <svg class="w-4 h-4 mt-1 shrink-0 text-blu" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M2 10c1.5 0 1.5-3 3-3s1.5 3 3 3 1.5-3 3-3 1.5 3 3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                    <span>{c}</span>
                  </li>
                ))}
              </ul>

              {/*
                I risultati compaiono solo se esistono davvero, e ogni numero
                stampa periodo e fonte. La regola è imposta dal codice, non
                dalla buona volontà.
              */}
              {l.kpi && l.kpi.length > 0 && (
                <dl class="mt-4 pt-4 border-t-2 border-navy/10 grid grid-cols-2 gap-3">
                  {l.kpi.map((k) => (
                    <div>
                      <dt class="text-[0.75rem] text-fumo">{k.etichetta}</dt>
                      <dd class="font-display font-extrabold text-3xl text-blu">{k.valore}</dd>
                      <dd class="text-[0.6875rem] text-fumo mt-0.5">
                        {k.periodo} · fonte: {k.fonte}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}

              {l.citazioneCliente && (
                <blockquote class="mt-4 pt-4 border-t-2 border-navy/10 text-[0.9375rem] italic">
                  “{l.citazioneCliente.testo}”
                  <footer class="mt-1 not-italic text-[0.8125rem] text-fumo">
                    {l.citazioneCliente.autore}, {l.citazioneCliente.ruolo}
                  </footer>
                </blockquote>
              )}
            </div>
          </article>
        </li>
      ))}
    </ul>

    <p class="mt-12 lg:mt-20 text-lg rivela">
      Vuoi vedere come verrebbe il tuo?{' '}
      <a href="#contatti" class="text-blu font-semibold underline underline-offset-4 decoration-2">
        Ti facciamo vedere una bozza
      </a>{' '}
      prima di firmare qualsiasi cosa.
    </p>
  </div>
</section>
