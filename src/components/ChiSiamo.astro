---
import { soci } from '../content/soci';

function iniziali(nome: string): string {
  const pulito = nome.replace(/[[\]]/g, '').trim();
  const parti = pulito.split(/\s+/).filter(Boolean);
  const prima = parti[0]?.[0] ?? 'A';
  const seconda = parti.length > 1 ? (parti[parti.length - 1]?.[0] ?? '') : '';
  return (prima + seconda).toUpperCase();
}
---

<section id="chi-siamo" class="py-16 md:py-24 bg-navy text-panna relative overflow-hidden">
  <!-- Onda di fondale sul navy. -->
  <svg
    class="absolute -top-6 left-0 w-[140%] h-[120px] text-blu/40 onda-viva"
    viewBox="0 0 1440 64" preserveAspectRatio="none" fill="none" aria-hidden="true"
  >
    <path d="M0 40c60 0 60-24 120-24s60 24 120 24 60-24 120-24 60 24 120 24 60-24 120-24 60 24 120 24 60-24 120-24 60 24 120 24 60-24 120-24 60 24 120 24 60-24 120-24 60 24 120 24" stroke="currentColor" stroke-width="10" stroke-linecap="round"/>
  </svg>

  <div class="contenitore relative">
    <div class="rivela max-w-[30ch]">
      <p class="occhiello occhiello-chiaro">Chi siamo</p>
      <h2 class="mt-4 titolone text-panna">
        Siamo in due, e <span class="marcato-blu">ci trovi</span>.
      </h2>
    </div>

    <div class="mt-8 grid md:grid-cols-2 gap-8 md:gap-12 rivela">
      <p class="text-lg md:text-xl leading-relaxed text-panna/85">
        Altamarea è un’agenzia piccola, e lo diciamo perché è il motivo per cui
        funziona: seguiamo pochi locali alla volta e li seguiamo bene. Non ti
        passano da un account manager all’altro, <strong class="text-sabbia font-semibold">parli sempre con noi due</strong>.
      </p>
      <p class="text-lg md:text-xl leading-relaxed text-panna/85">
        Siamo cresciuti qui. Sappiamo che da giugno a settembre non hai tempo di
        rispondere al telefono, che la stagione si decide a gennaio e che un
        ombrellone vuoto ad agosto non si recupera più. Per questo lavoriamo con
        <strong class="text-sabbia font-semibold"> i tuoi tempi</strong>, non con i nostri.
      </p>
    </div>

    <ul class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-5 md:gap-6">
      {soci.map((s) => (
        <li class="rivela bg-white/[0.06] rounded-2xl p-6 md:p-7 border border-white/10 border-l-4 border-l-sabbia">
          <div class="flex items-center gap-4">
            {s.ritratto ? (
              <img
                src={s.ritratto}
                alt={`Ritratto di ${s.nome}`}
                width="88"
                height="88"
                loading="lazy"
                decoding="async"
                class="w-[88px] h-[88px] rounded-full object-cover shrink-0"
              />
            ) : (
              <span
                class="w-[88px] h-[88px] rounded-full bg-sabbia text-navy font-display font-extrabold text-2xl flex items-center justify-center shrink-0"
                aria-hidden="true"
              >
                {iniziali(s.nome)}
              </span>
            )}
            <div>
              <h3 class="text-[1.375rem] text-panna">{s.nome}</h3>
              <p class="text-[0.8125rem] uppercase tracking-[0.14em] text-sabbia mt-1.5 font-semibold">
                {s.ruolo}
              </p>
            </div>
          </div>
          <p class="mt-4 text-[0.9375rem] md:text-base text-panna/80">{s.descrizione}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
